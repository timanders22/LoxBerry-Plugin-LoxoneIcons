#!/bin/bash
# LoxoneIcons - uninstall
# command <TEMPFOLDER> <NAME> <FOLDER> <VERSION> <BASEFOLDER>
#
# Wird von LoxBerry als root ausgefuehrt. Rueckgabewert 0 = in Ordnung,
# 1 = Warnung (die Deinstallation laeuft trotzdem weiter).
#
# ===================================================================
# WARUM ES DIESE DATEI GIBT
# ===================================================================
#
# LoxBerry raeumt die Plugin-Ordner weg. Drei Dinge blieben sonst liegen:
#
#   1. data/plugins/<ordner>.upgrade_sicherung
#      Dorthin legt preupgrade.sh die bereits heruntergeladenen Symbole,
#      damit ein Update nicht erneut mehrere Minuten und einiges an
#      Datenverkehr auf den Loxone-Servern kostet. Der Ordner liegt
#      absichtlich NEBEN dem Datenordner - beim Deinstallieren ist genau
#      das falsch, und es sind je nach Bestand einige Megabyte.
#   2. Ein noch laufender Download. download_icons.sh wird von der
#      Oberflaeche abgekoppelt gestartet und laeuft weiter, auch wenn das
#      Plugin verschwindet - und schreibt dann in Ordner, die es nicht
#      mehr gibt.
#   3. Die Sperrdatei download.running im Datenordner. Die geht zwar mit
#      dem Datenordner, wird hier aber der Vollstaendigkeit halber vor dem
#      Beenden geloescht, damit ein noch laufender Durchgang beim Aufraeumen
#      nicht ins Leere greift.
#
# ZUR PROZESSSUCHE: Eine Prozessnummer ist kein Ausweis. "pkill -f
# download_icons.sh" waere falsch - das durchsucht die ganze Befehlszeile und
# traefe auch einen Editor mit offener Datei. Eine Nummer aus der Sperrdatei
# ist es aber ebenso wenig: sie kann veraltet und laengst neu vergeben sein.
# Deshalb geht JEDE Nummer - die aus der Sperrdatei wie jeder Fund aus /proc -
# durch dieselbe argumentweise Pruefung (ist_download), und zwar vor JEDEM
# Signal erneut.

PDIR=$3
[ -n "$PDIR" ] || PDIR="loxoneicons"
BASE="${5:-$LBHOMEDIR}"
# Dritter Rueckfall: der eigene Ablageort. Bewusst kein fest verdrahteter
# Systempfad - LoxBerry laesst sich anderswohin installieren, und der
# Plugin-Pruefer sucht die Zeichenkette, ohne den Zusammenhang zu sehen.
# LoxBerry legt dieses Skript als <home>/data/system/uninstall/<name> ab
# (plugininstall.pl, "Copy Uninstall file"). Bis 2.0.4 stand hier
# data/plugins/<ordner>/uninstall/ und es wurden vier Ebenen hochgegangen -
# das landete eine Ebene UEBER der LoxBerry-Wurzel.
#
# Bis 2.0.8 ging dieser Rueckfall fest drei Ebenen hoch und pruefte nur, ob
# dort data/plugins liegt. In WSL gemessen (18.09.2026,
# Pruefung-LoxoneIcons-2.0.8, Fall H4): in einem fremden Baum mit
# data/plugins, aber ohne config/system/general.json, loeschte das Skript
# Upgrade-Sicherung und Zweitschrift - 0 von 2 Dateien blieben. Ein LoxBerry
# hat immer config/system/general.json (Regeln/06, Raumklima-Vorfall vom
# 05.09.2026). Gesucht wird deshalb aufwaerts nach allen drei Merkmalen
# (Vorlage lb_wurzel_suchen() aus Regeln/06).
lb_wurzel_suchen() {
    v=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd)
    i=0
    while [ -n "$v" ] && [ "$v" != "/" ] && [ $i -lt 8 ]; do
        if [ -d "$v/config/plugins" ] && [ -d "$v/data/plugins" ] \
           && [ -f "$v/config/system/general.json" ]; then
            echo "$v"; return 0
        fi
        v=$(dirname "$v"); i=$((i + 1))
    done
    return 1
}
if [ -z "$BASE" ] || [ ! -d "$BASE" ]; then
    if ! BASE=$(lb_wurzel_suchen); then
        echo "<WARNING> Die LoxBerry-Wurzel liess sich nicht ermitteln - es wird nichts aufgeraeumt."
        exit 1
    fi
fi

PDATA="$BASE/data/plugins/$PDIR"
SKRIPT="$BASE/bin/plugins/$PDIR/download_icons.sh"
LOCK="$PDATA/download.running"

# Der Pfad ist die Identitaet des Skripts; ein Symlink davor wird aufgeloest.
SKRIPT_R=$(readlink -f "$SKRIPT" 2>/dev/null)
[ -n "$SKRIPT_R" ] || SKRIPT_R="$SKRIPT"

# Der Download laeuft als loxberry: die Oberflaeche, postinstall.sh (Z. 98)
# und postupgrade.sh (Z. 37) starten ihn alle als dieser Benutzer. Dieses
# Skript hier laeuft als root - "id -u" waere deshalb der falsche Rueckfall,
# er ergaebe 0 und damit eine Suche, die den Download gar nicht sehen kann.
# Gibt es den Benutzer nicht, gilt der Eigentuemer der LoxBerry-Wurzel.
DIENST_UID=$(id -u loxberry 2>/dev/null)
[ -n "$DIENST_UID" ] || DIENST_UID=$(stat -c %u "$BASE" 2>/dev/null)
[ -n "$DIENST_UID" ] || DIENST_UID=$(id -u)

# ---------- Einen Download argumentweise erkennen ----------
#
# Gemessen am 18.09.2026 in WSL Ubuntu (Pruefung-LoxoneIcons-2.0.7,
# messprotokoll_vorher.txt): ein ueber seine Shebang-Zeile gestartetes
# Bash-Skript traegt
#     argv[0] = /bin/bash           (der Interpreter, NICHT das Skript)
#     argv[1] = <voller Skriptpfad>
#     argv[2] = --force             (nur beim vollstaendigen Neuaufbau)
#
# Bis 2.0.7 verglich die Schleife hier argv[0] mit dem Skriptpfad. Das trifft
# nie: ein laufender Download ohne Sperrdatei ueberlebte die Deinstallation
# (Pruefstand Fall 4 und 5: "erwartet TOT, gemessen LEBT"). Und der Zweig
# darueber schickte das Signal an die Nummer aus der Sperrdatei, ohne die
# Befehlszeile anzusehen (Fall 1: Koeder "sleep 900", gemessen
# "<OK> Laufenden Download beendet (PID 666810, aus der Sperrdatei)." -
# der Koeder war danach tot).
#
# Dieselbe Pruefung steht wortgleich in bin/download_icons.sh (dort ohne
# /proc-Durchlauf, nur fuer die Nummer aus der Sperrdatei). Wer die eine
# aendert, aendert die andere mit.
ist_download() {
    [ -r "/proc/$1/cmdline" ] || return 1
    {
        IFS= read -r -d '' li_a0 || return 1
        IFS= read -r -d '' li_a1 || return 1
        case "${li_a0##*/}" in bash|sh) ;; *) return 1 ;; esac
        if [ "$li_a1" != "$SKRIPT" ] && [ "$li_a1" != "$SKRIPT_R" ]; then
            # Relativ gestartet: gegen das Arbeitsverzeichnis des Prozesses.
            case "$li_a1" in
                /*) li_voll="$li_a1" ;;
                *)  li_cwd=$(readlink "/proc/$1/cwd" 2>/dev/null)
                    [ -n "$li_cwd" ] || return 1
                    li_voll="$li_cwd/$li_a1" ;;
            esac
            [ "$(readlink -f "$li_voll" 2>/dev/null)" = "$SKRIPT_R" ] || return 1
        fi
        # Hoechstens noch --force, und nichts dahinter. Anders ruft das Plugin
        # das Skript nirgends auf.
        if IFS= read -r -d '' li_a2; then
            [ "$li_a2" = "--force" ] || return 1
            IFS= read -r -d '' li_a3 && return 1
        fi
        return 0
    } < "/proc/$1/cmdline"
}

# Alle eigenen Laeufe, nicht nur der aus der Sperrdatei: ein zweiter Lauf ohne
# Eintrag blieb bis 2.0.7 stehen (Pruefstand Fall 7b).
downloads() {
    {
        for li_d in /proc/[0-9]*; do
            li_p="${li_d#/proc/}"
            ist_download "$li_p" || continue
            [ "$(stat -c %u "$li_d" 2>/dev/null)" = "$DIENST_UID" ] || continue
            echo "$li_p"
        done
        li_s=""
        [ -f "$LOCK" ] && IFS= read -r li_s < "$LOCK" 2>/dev/null
        case "$li_s" in
            ''|*[!0-9]*) ;;
            *)  if ist_download "$li_s" \
                   && [ "$(stat -c %u "/proc/$li_s" 2>/dev/null)" = "$DIENST_UID" ]; then
                    echo "$li_s"
                fi ;;
        esac
    } | sort -un
}

WARNUNG=0
ZIEL=$(downloads)
if [ -z "$ZIEL" ]; then
    echo "<INFO> Es lief kein Download."
else
    echo "<INFO> Laufender Download wird beendet (PID $(printf '%s' "$ZIEL" | tr '\n' ' '))."
    kill $ZIEL 2>/dev/null
    for i in 1 2 3 4 5; do
        [ -n "$(downloads)" ] || break
        sleep 1
    done
    # Vor dem harten Signal wird NEU gesucht, nicht die Liste von vorhin
    # wiederverwendet: zwischen den beiden Signalen kann ein Prozess enden und
    # seine Nummer neu vergeben werden - "kill -9" traefe dann einen Fremden.
    REST=$(downloads)
    if [ -n "$REST" ]; then
        kill -9 $REST 2>/dev/null
        sleep 1
    fi
    # "beendet" ist eine Zusicherung, kein Rueckgabewert: es wird nachgesehen.
    UEBRIG=$(downloads)
    if [ -n "$UEBRIG" ]; then
        echo "<WARNING> Ein Download laeuft weiter (PID $(printf '%s' "$UEBRIG" | tr '\n' ' '))."
        WARNUNG=1
    else
        echo "<OK> Laufenden Download beendet."
    fi
fi
# Die Sperrdatei geht in jedem Fall - auch eine veraltete, deren Nummer
# inzwischen einem Fremden gehoert. Sonst blockiert sie den naechsten Lauf.
rm -f "$LOCK"

if [ -d "$PDATA.upgrade_sicherung" ]; then
    GROESSE=$(du -sh "$PDATA.upgrade_sicherung" 2>/dev/null | cut -f1)
    rm -rf "$PDATA.upgrade_sicherung" \
        && echo "<OK> Upgrade-Sicherung entfernt ($GROESSE)."
else
    echo "<INFO> Keine Upgrade-Sicherung vorhanden."
fi
# Nebenablagen eines abgebrochenen preupgrade.sh (<ordner>.upgrade_sicherung.neu.<pid>
# und .alt.<pid>). preupgrade.sh loescht sie bewusst nie - sie koennen die
# einzige Abschrift sein -, also gehen sie hier.
for REST in "$PDATA.upgrade_sicherung.neu."* "$PDATA.upgrade_sicherung.alt."*; do
    [ -d "$REST" ] || continue
    rm -rf "$REST" && echo "<OK> Rest einer abgebrochenen Sicherung entfernt (${REST##*/})."
done

# Seit 2.0.5 fuehrt die Oberflaeche eine Zweitschrift der Konfiguration NEBEN
# dem Konfigurationsordner (config/plugins/<ordner>.backup.json), damit das
# Aktionstoken ein Upgrade uebersteht. Beim Deinstallieren gehoert sie weg;
# sie traegt das Token.
ZWEIT="$BASE/config/plugins/$PDIR.backup.json"
if [ -f "$ZWEIT" ]; then
    rm -f "$ZWEIT" "$ZWEIT".tmp.* && echo "<OK> Zweitschrift der Konfiguration entfernt."
fi

echo "<INFO> Die heruntergeladenen Symbole gehen mit dem Datenordner des"
echo "<INFO> Plugins. Wer sie behalten will, sichert sie VOR dem"
echo "<INFO> Deinstallieren aus $PDATA."
exit "$WARNUNG"
